{% extends 'base.html.twig' %}

{% block title %}
    {{ recipe.title }} - PEDIBUS JAMBUS
{% endblock %}

{% block body %}
    <div class="min-h-screen py-12 px-4">
        <div class="max-w-3xl mx-auto">

            <a href="{{ path('public_recipes_index') }}" class="inline-flex items-center text-gray-600 hover:text-gray-900 mb-6">
                <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
                </svg>
                Toutes les recettes
            </a>

            <div class="bg-white rounded-2xl shadow-xl border border-gray-200 overflow-hidden">

                {% if recipe.hasPhoto %}
                    <div class="aspect-[16/9] bg-gray-100">
                        <img src="{{ vich_uploader_asset(recipe, 'photoFile') }}" alt="{{ recipe.title }}" class="w-full h-full object-cover">
                    </div>
                {% endif %}

                <div class="p-6 md:p-8">
                    <span class="inline-block px-3 py-1 text-sm bg-orange-100 text-orange-800 rounded-full mb-4">
                        {{ recipe.categoryLabel }}
                    </span>

                    <h1 class="text-3xl font-bold text-gray-900 mb-4">{{ recipe.title }}</h1>

                    {% if recipe.servings %}
                        <div class="flex items-center gap-2 text-gray-600 mb-8">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a4 4 0 00-3-3.87M9 20H4v-2a4 4 0 013-3.87m6-1.13a4 4 0 10-4-4 4 4 0 004 4zm6 0a4 4 0 10-4-4"/>
                            </svg>
                            <span>Pour {{ recipe.servings }} personnes</span>
                        </div>
                    {% endif %}

                    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">

                        {# Ingrédients #}
                        <div class="md:col-span-1">
                            <h2 class="text-lg font-bold text-gray-900 mb-4 pb-2 border-b border-gray-200">
                                Ingrédients
                            </h2>
                            <ul class="space-y-2">
                                {% for ingredient in recipe.ingredientsList %}
                                    <li class="flex items-start text-gray-700">
                                        <span class="w-1.5 h-1.5 rounded-full bg-green-500 mt-2 mr-3 flex-shrink-0"></span>
                                        <span>{{ ingredient }}</span>
                                    </li>
                                {% endfor %}
                            </ul>
                        </div>

                        {# Étapes #}
                        <div class="md:col-span-2">
                            <h2 class="text-lg font-bold text-gray-900 mb-4 pb-2 border-b border-gray-200">
                                Préparation
                            </h2>
                            <ol class="space-y-4">
                                {% for step in recipe.stepsList %}
                                    <li class="flex gap-4">
                                        <span class="flex-shrink-0 w-7 h-7 rounded-full bg-green-600 text-white text-sm font-bold flex items-center justify-center">
                                            {{ loop.index }}
                                        </span>
                                        <p class="text-gray-700 pt-0.5">{{ step }}</p>
                                    </li>
                                {% endfor %}
                            </ol>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}