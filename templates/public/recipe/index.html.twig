{% extends 'base.html.twig' %}

{% block title %}
    Nos recettes - PEDIBUS JAMBUS
{% endblock %}

{% block body %}
    <div class="min-h-screen py-12 px-4 relative">
        <div class="max-w-6xl mx-auto">
            <div class="text-center mb-12">
                <h1 class="text-4xl font-bold text-gray-900 mb-4">Nos recettes</h1>
                <p class="text-lg text-gray-700 max-w-3xl mx-auto">
                    Les recettes de notre association, à partager et à cuisiner en toute simplicité.
                </p>
            </div>

            {% if recipes|length > 0 %}
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                    {% for recipe in recipes %}
                        <a href="{{ path('public_recipe_show', {'slug': recipe.slug}) }}"
                            class="group bg-white rounded-2xl shadow-sm hover:shadow-lg border border-gray-200/80 overflow-hidden transition-all duration-300">

                            <div class="aspect-[4/3] overflow-hidden bg-gray-100">
                                {% if recipe.hasPhoto %}
                                    <img src="{{ vich_uploader_asset(recipe, 'photoFile') }}"
                                        alt="{{ recipe.title }}"
                                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300">
                                {% else %}
                                    <div class="w-full h-full flex items-center justify-center text-gray-300">
                                        <svg class="w-14 h-14" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
                                        </svg>
                                    </div>
                                {% endif %}
                            </div>

                            <div class="p-4">
                                <span class="inline-block px-2 py-1 text-xs bg-orange-100 text-orange-800 rounded mb-2">
                                    {{ recipe.categoryLabel }}
                                </span>

                                <h3 class="font-bold text-gray-900 group-hover:text-green-600 transition-colors">
                                    {{ recipe.title }}
                                </h3>

                                {% if recipe.servings %}
                                    <p class="text-sm text-gray-500 mt-2 flex items-center gap-1">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a4 4 0 00-3-3.87M9 20H4v-2a4 4 0 013-3.87m6-1.13a4 4 0 10-4-4 4 4 0 004 4zm6 0a4 4 0 10-4-4"/>
                                        </svg>
                                        {{ recipe.servings }} personnes
                                    </p>
                                {% endif %}
                            </div>
                        </a>
                    {% endfor %}
                </div>
            {% else %}
                <div class="bg-white rounded-2xl shadow-xl border border-gray-200 p-12 text-center">
                    <div class="max-w-md mx-auto">
                        <div class="p-4 bg-gray-100 rounded-full w-20 h-20 mx-auto mb-6 flex items-center justify-center">
                            <svg class="w-10 h-10 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
                            </svg>
                        </div>
                        <h3 class="text-2xl font-bold text-gray-900 mb-4">Aucune recette pour le moment</h3>
                        <p class="text-gray-700 mb-8">Revenez bientôt pour découvrir nos recettes.</p>
                        <a href="{{ path('app_home') }}" class="inline-flex items-center px-8 py-3 bg-gradient-to-r from-green-600 to-green-700 text-white font-medium rounded-xl hover:from-green-700 hover:to-green-800 transition-all duration-300 shadow-lg">
                            Retour à l'accueil
                        </a>
                    </div>
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}