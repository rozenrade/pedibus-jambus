{% extends 'base.html.twig' %}

{% block title %}
    Albums - Administration
{% endblock %}

{% block body %}
    <div class="min-h-screen bg-gradient-to-br from-gray-50 to-blue-50">
        <!-- Header -->
        <div class="bg-white shadow-sm border-b border-gray-200">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="flex justify-between items-center py-4">
                    <div>
                        <h1 class="text-2xl font-bold text-gray-900">Gestion des albums</h1>
                        <p class="text-gray-600 mt-1">Organisez et gérez vos collections photos</p>
                    </div>
                    <div class="flex items-center space-x-4">
                        <a href="{{ path('admin_album_new') }}" class="bg-blue-500 hover:bg-blue-600 text-white px-4 py-2.5 rounded-lg font-medium shadow-sm flex items-center transition-all transform hover:-translate-y-0.5">
                            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewbox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
                            </svg>
                            Nouvel album
                        </a>
                        <div class="w-8 h-8 bg-blue-600 rounded-full flex items-center justify-center text-white font-bold">
                            {{ app.user.email|first|upper }}
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Contenu principal -->
        <div
        class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
		
        <!-- Filtres et tri -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4 mb-6">
            <div class="flex flex-col sm:flex-row justify-between items-center gap-4">
                <div class="flex items-center space-x-4">
                    <span class="text-sm text-gray-700 font-medium">{{ albums|length }} albums</span>
                    <div class="flex space-x-2">
                        <a href="{{ path('admin_album_index', {'filter': 'all', 'sort': currentSort}) }}"
                            class="px-3 py-1.5 text-sm rounded-lg font-medium transition-colors
                            {{ currentFilter == 'all' ? 'bg-blue-100 text-blue-700' : 'text-gray-600 hover:bg-gray-100' }}">
                            Tous
                        </a>
                        <a href="{{ path('admin_album_index', {'filter': 'public', 'sort': currentSort}) }}"
                            class="px-3 py-1.5 text-sm rounded-lg font-medium transition-colors
                            {{ currentFilter == 'public' ? 'bg-blue-100 text-blue-700' : 'text-gray-600 hover:bg-gray-100' }}">
                            Publics
                        </a>
                        <a href="{{ path('admin_album_index', {'filter': 'private', 'sort': currentSort}) }}"
                            class="px-3 py-1.5 text-sm rounded-lg font-medium transition-colors
                            {{ currentFilter == 'private' ? 'bg-blue-100 text-blue-700' : 'text-gray-600 hover:bg-gray-100' }}">
                            Privés
                        </a>
                    </div>
                </div>

                <div class="flex items-center space-x-4">
                    <select id="sort-select" class="px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
                        <option value="recent" {{ currentSort == 'recent' ? 'selected' : '' }}>Trier par : Date récente</option>
                        <option value="title" {{ currentSort == 'title' ? 'selected' : '' }}>Trier par : Titre A-Z</option>
                        <option value="photos" {{ currentSort == 'photos' ? 'selected' : '' }}>Trier par : Nombre de photos</option>
                    </select>
                </div>
            </div>
        </div>
        {% if albums|length == 0 %}
            <!-- État vide -->
            <div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-12 text-center">
                <div class="max-w-md mx-auto">
                    <div class="w-24 h-24 bg-gradient-to-r from-blue-100 to-blue-50 rounded-full flex items-center justify-center mx-auto mb-6">
                        <svg class="w-12 h-12 text-blue-600" fill="none" stroke="currentColor" viewbox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
                        </svg>
                    </div>
                    <h3 class="text-2xl font-bold text-gray-900 mb-3">Commencez votre collection</h3>
                    <p class="text-gray-600 mb-8">
                        Créez votre premier album pour organiser vos photos de randonnée et partager vos souvenirs.
                    </p>
                    <a href="{{ path('admin_album_new') }}" class="inline-flex items-center bg-gradient-to-r from-blue-600 to-blue-700 hover:from-blue-700 hover:to-blue-800 text-white px-6 py-3 rounded-lg font-medium shadow-sm transition-all transform hover:-translate-y-0.5">
                        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewbox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
                        </svg>
                        Créer votre premier album
                    </a>
                </div>
            </div>
        {% endif %}


        <!-- Grille des albums -->
        <div id="albums-container" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">

            {% for album in albums %}
                <div class="group bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1">
                    <!-- Header de la carte -->
                    <div class="relative">
                        {% if album.coverImage %}
                            {% set coverPath = 'uploads/albums/covers/' ~ album.coverImage %}
                            <div class="h-56 overflow-hidden">
                                <img
                                src="{{ coverPath | imagine_filter('gallery_grid') }}"
                                alt="{{ album.title }}"
                                width="800"
                                height="800"
                                loading="lazy"
                                decoding="async"
                                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
                            </div>
                        {% else %}
                            <div class="h-56 bg-gradient-to-r from-gray-100 to-gray-200 flex items-center justify-center group-hover:from-gray-200 group-hover:to-gray-300 transition-colors">
                                <div class="text-center">
                                    <svg class="w-12 h-12 text-gray-400 mx-auto mb-2" fill="none" stroke="currentColor" viewbox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                                    </svg>
                                    <p class="text-sm text-gray-500">Pas de couverture</p>
                                </div>
                            </div>
                        {% endif %}

                        <!-- Badge de visibilité -->
                        <div class="absolute top-4 right-4">
                            <span class="px-3 py-1 text-xs font-medium rounded-full shadow-sm {{ album.isPublic ? 'bg-green-100 text-green-800 border border-green-200' : 'bg-gray-100 text-gray-800 border border-gray-200' }}">
                                {{ album.isPublic ? '🌍 Public' : '🔒 Privé' }}
                            </span>
                        </div>

                        <!-- Overlay d'actions -->
                        <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end">
                            <div class="p-4 w-full">
                                <div class="flex justify-center space-x-3">
                                    <a href="{{ path('admin_album_show', {'id': album.id}) }}" class="bg-white/90 hover:bg-white text-gray-800 px-4 py-2 rounded-lg text-sm font-medium transition-colors backdrop-blur-sm">
                                        👁️ Voir
                                    </a>
                                    <a href="{{ path('admin_album_edit', {'id': album.id}) }}" class="bg-white/90 hover:bg-white text-blue-600 px-4 py-2 rounded-lg text-sm font-medium transition-colors backdrop-blur-sm">
                                        ✏️ Modifier
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Contenu de la carte -->
                    <div class="p-5">
                        <!-- Titre et date -->
                        <div class="mb-4">
                            <h3 class="font-bold text-lg text-gray-900 mb-2 group-hover:text-blue-600 transition-colors line-clamp-1">
                                {{ album.title }}
                            </h3>
                            <div class="flex items-center text-sm text-gray-500">
                                <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewbox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                                </svg>
                                {{ album.eventDate|date('d M Y') }}
                            </div>
                        </div>

                        <!-- Description -->
                        {% if album.description %}
                            <p class="text-gray-600 text-sm mb-4 line-clamp-2">
                                {{ album.description }}
                            </p>
                        {% endif %}

                        <!-- Footer avec statistiques -->
                        <div class="pt-4 border-t border-gray-100">
                            <div class="flex justify-between items-center">
                                <div
                                class="flex items-center space-x-4">
                                <!-- Nombre de photos -->
                                <div class="flex items-center text-sm text-gray-600">
                                    <svg class="w-4 h-4 mr-1.5 text-gray-400" fill="none" stroke="currentColor" viewbox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                                    </svg>
                                    <span class="font-medium">{{ album.photos|length }}
                                    photos</span>
                                </div>
                            </div>

                            <!-- Menu d'actions rapides -->
                            <div class="relative group/menu">
                                <button class="p-2 text-gray-400 hover:text-gray-600 hover:bg-gray-100 rounded-lg transition-colors">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewbox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5v.01M12 12v.01M12 19v.01M12 6a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2z"/>
                                    </svg>
                                </button>

                                <!-- Menu déroulant -->
                                <div class="absolute right-0 bottom-full mb-2 w-48 bg-white rounded-lg shadow-xl border border-gray-200 py-2 z-10 opacity-0 invisible group-hover/menu:opacity-100 group-hover/menu:visible transition-all duration-200">
                                    <a href="{{ path('admin_album_show', {'id': album.id}) }}" class="flex items-center px-4 py-2 text-sm text-gray-700 hover:bg-gray-50">
                                        <svg class="w-4 h-4 mr-3 text-gray-400" fill="none" stroke="currentColor" viewbox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                                        </svg>
                                        Voir l'album
                                    </a>
                                    <a href="{{ path('admin_album_edit', {'id': album.id}) }}" class="flex items-center px-4 py-2 text-sm text-gray-700 hover:bg-gray-50">
                                        <svg class="w-4 h-4 mr-3 text-blue-400" fill="none" stroke="currentColor" viewbox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                                        </svg>
                                        Modifier
                                    </a>
                                    <a href="{{ path('admin_photo_new_to_album', {'albumId': album.id}) }}" class="flex items-center px-4 py-2 text-sm text-gray-700 hover:bg-gray-50">
                                        <svg class="w-4 h-4 mr-3 text-green-400" fill="none" stroke="currentColor" viewbox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
                                        </svg>
                                        Ajouter des photos
                                    </a>
                                    <div class="border-t border-gray-100 my-1"></div>
                                    <a href="{{ path('admin_album_delete', {'id': album.id}) }}" class="flex items-center px-4 py-2 text-sm text-red-600 hover:bg-red-50">
                                        <svg class="w-4 h-4 mr-3" fill="none" stroke="currentColor" viewbox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                                        </svg>
                                        Supprimer
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>

    <style>
        @keyframes fade-in {
            from {
                opacity: 0;
                transform: translateY(-10px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        .animate-fade-in {
            animation: fade-in 0.3s ease-out;
        }
    </style>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Tri : redirige avec le query param sort
            const sortSelect = document.getElementById('sort-select');
            sortSelect.addEventListener('change', function () {
                const url = new URL(window.location.href);
                url.searchParams.set('sort', this.value);
                window.location.href = url.toString();
            });

            // Switch vue liste / grille
            const container = document.getElementById('albums-container');
            const listBtn = document.getElementById('view-list-btn');
            const gridBtn = document.getElementById('view-grid-btn');

            function setView(view) {
                if (view === 'list') {
                    container.classList.remove('md:grid-cols-2', 'lg:grid-cols-3');
                    container.classList.add('grid-cols-1');
                    listBtn.classList.add('bg-gray-50');
                    listBtn.classList.remove('bg-white');
                    gridBtn.classList.remove('bg-gray-50');
                    gridBtn.classList.add('bg-white');
                    } else {
                    container.classList.add('md:grid-cols-2', 'lg:grid-cols-3');
                    gridBtn.classList.add('bg-gray-50');
                    gridBtn.classList.remove('bg-white');
                    listBtn.classList.remove('bg-gray-50');
                    listBtn.classList.add('bg-white');
                }
                localStorage.setItem('albumsView', view);
            }

            listBtn.addEventListener('click', () => setView('list'));
            gridBtn.addEventListener('click', () => setView('grid'));

            // Restaure la préférence de vue au chargement
            const savedView = localStorage.getItem('albumsView') || 'grid';
            setView(savedView);
        });
    </script>
{% endblock %}