{% extends 'base.html.twig' %}

{% block title %}Modifier {{ member.name }} - Administration{% endblock %}

{% block body %}
<div class="container mx-auto px-4 py-8 max-w-2xl">
    <div class="mb-8">
        <a href="{{ path('admin_member_index') }}" class="inline-flex items-center text-gray-600 hover:text-gray-900 mb-4">
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
            </svg>
            Retour à la liste
        </a>
        <h1 class="text-2xl font-bold text-gray-900">Modifier {{ member.name }}</h1>
    </div>

    <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
        {{ form_start(form, {'attr': {'class': 'space-y-6'}}) }}

        <div>
            {{ form_label(form.name, null, {'label_attr': {'class': 'block mb-2 font-medium text-gray-900'}}) }}
            {{ form_widget(form.name, {'attr': {'class': 'w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500'}}) }}
            {{ form_errors(form.name) }}
        </div>

        <div>
            {{ form_label(form.category, null, {'label_attr': {'class': 'block mb-2 font-medium text-gray-900'}}) }}
            {{ form_widget(form.category, {'attr': {'class': 'w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500'}}) }}
            {{ form_errors(form.category) }}
        </div>

        <div>
            {{ form_label(form.role, null, {'label_attr': {'class': 'block mb-2 font-medium text-gray-900'}}) }}
            {{ form_widget(form.role, {'attr': {'class': 'w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500'}}) }}
            {{ form_errors(form.role) }}
        </div>

        <div>
            {{ form_label(form.phone, null, {'label_attr': {'class': 'block mb-2 font-medium text-gray-900'}}) }}
            <p class="text-sm text-gray-500 mt-1">Format attendu : 01 23 45 67 80</p>
            {{ form_widget(form.phone, {'attr': {'type': 'tel', 'pattern': '^[0-9\\s\\-\\(\\)\\+]{7,20}$', 'class': 'w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500'}}) }}
            {{ form_errors(form.phone) }}
        </div>

        <div>
            {{ form_label(form.email, null, {'label_attr': {'class': 'block mb-2 font-medium text-gray-900'}}) }}
            {{ form_widget(form.email, {'attr': {'class': 'w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500'}}) }}
            {{ form_errors(form.email) }}
        </div>

        <div id="quote-field">
            {{ form_label(form.quote, null, {'label_attr': {'class': 'block mb-2 font-medium text-gray-900'}}) }}
            {{ form_widget(form.quote, {'attr': {'class': 'w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500'}}) }}
            {{ form_errors(form.quote) }}
        </div>

        <div>
            {{ form_label(form.photoFile, null, {'label_attr': {'class': 'block mb-2 font-medium text-gray-900'}}) }}
            {{ form_widget(form.photoFile, {'attr': {'class': 'w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500'}}) }}
            {{ form_errors(form.photoFile) }}
            <p class="text-sm text-gray-500 mt-1">Laissez vide pour conserver la photo actuelle (ou aucune photo).</p>

            {% if member.hasPhoto %}
                <div class="mt-4">
                    <p class="text-sm text-gray-600 mb-2">Photo actuelle :</p>
                    <img src="{{ vich_uploader_asset(member, 'photoFile') }}" alt="{{ member.name }}" class="w-24 h-24 rounded-full object-cover border border-gray-200">
                </div>
            {% endif %}
        </div>

        <div class="flex justify-between pt-6 border-t border-gray-200">
            <a href="{{ path('admin_member_index') }}" class="px-4 py-2 border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50">
                Annuler
            </a>
            <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg font-medium">
                Enregistrer
            </button>
        </div>

        {{ form_end(form) }}
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const categorySelect = document.querySelector('#member_category');
            const quoteField = document.getElementById('quote-field');

            function toggleQuote() {
                quoteField.style.display = categorySelect.value === '{{ constant('App\\Entity\\Member::CATEGORY_PRESIDENT_HONNEUR') }}' ? 'block' : 'none';
            }

            categorySelect.addEventListener('change', toggleQuote);
            toggleQuote();
        });
    </script>
{% endblock %}