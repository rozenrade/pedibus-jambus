{# templates/admin/hiking_program/index.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}
    Programmes
{% endblock %}

{% block body %}
    <div class="min-h-screen bg-gray-50 p-4">
        <div class="max-w-6xl mx-auto">
            <!-- Header -->
            <div class="mb-6 flex justify-between items-center">
                <h1 class="text-2xl font-bold text-gray-800">Liste des documents de randonnée</h1>
                <a href="{{ path('admin_programs_new') }}" class="px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700">
                    + Nouveau
                </a>
            </div>

            <!-- Filtre -->
            <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4 mb-6">
                <div class="flex items-center justify-between">
                    <span class="text-sm text-gray-700 font-medium">{{ totalCount }} document{{ totalCount > 1 ? 's' : '' }}</span>
                    <div class="flex space-x-2">
                        <a href="{{ path('admin_programs_index', {'filter': 'all'}) }}"
                            class="px-3 py-1.5 text-sm rounded-lg font-medium transition-colors
                            {{ currentFilter == 'all' ? 'bg-green-100 text-green-700' : 'text-gray-600 hover:bg-gray-100' }}">
                            Tous
                        </a>
                        <a href="{{ path('admin_programs_index', {'filter': 'public'}) }}"
                            class="px-3 py-1.5 text-sm rounded-lg font-medium transition-colors
                            {{ currentFilter == 'public' ? 'bg-green-100 text-green-700' : 'text-gray-600 hover:bg-gray-100' }}">
                            Publics
                        </a>
                        <a href="{{ path('admin_programs_index', {'filter': 'private'}) }}"
                            class="px-3 py-1.5 text-sm rounded-lg font-medium transition-colors
                            {{ currentFilter == 'private' ? 'bg-green-100 text-green-700' : 'text-gray-600 hover:bg-gray-100' }}">
                            Privés
                        </a>
                    </div>
                </div>
            </div>

            <!-- Liste groupée par année -->
            {% if groupedPrograms|length > 0 %}
                {% for year, programs in groupedPrograms %}
                    <div class="mb-8">
                        <h2 class="text-xl font-bold text-gray-700 mb-4 flex items-center">
                            <span class="bg-gray-800 text-white px-3 py-1 rounded-lg mr-3">{{ year }}</span>
                            <span class="text-gray-600 text-sm">{{ programs|length }} document(s)</span>
                        </h2>

                        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                            {% for program in programs %}
                                <div class="bg-white border border-gray-200 rounded-lg p-4 hover:shadow-md transition-shadow flex flex-col">

                                    {# Titre du programme #}
                                    <div class="mb-2">
                                        {% if program.title %}
                                            <h3 class="text-base font-semibold text-gray-900 leading-snug">
                                                {{ program.title }}
                                            </h3>
                                        {% else %}
                                            <h3 class="text-base font-medium text-gray-400 italic">
                                                Programme sans titre
                                            </h3>
                                        {% endif %}
                                    </div>

                                    {# Trimestre / type #}
                                    <div class="mb-3">
                                        {% if program.quarter == null %}
                                            <span class="inline-block px-2 py-1 text-xs bg-green-100 text-green-800 rounded">
                                                Sorties Grandes Évasions
                                            </span>
                                        {% elseif program.quarter == 4 %}
                                            <span class="inline-block px-2 py-1 text-xs bg-yellow-100 text-yellow-800 rounded">
                                                Courts séjours
                                            </span>
                                        {% elseif program.quarter == 5 %}
                                            <span class="inline-block px-2 py-1 text-xs bg-red-100 text-red-800 rounded">
                                                Privé
                                            </span>
                                        {% else %}
                                            <span class="inline-block px-2 py-1 text-xs bg-blue-100 text-blue-800 rounded">
                                                {{ program.quarter }}er trimestre
                                            </span>
                                        {% endif %}
                                    </div>

                                    {# Visibilité #}
                                    <div class="mb-3">
                                        {% if program.isPublic %}
                                            <span class="inline-flex items-center text-xs text-gray-500">
                                                <svg class="w-3.5 h-3.5 mr-1" fill="none" stroke="currentColor" viewbox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                                                </svg>
                                                Public
                                            </span>
                                        {% else %}
                                            <span class="inline-flex items-center text-xs text-orange-600 font-medium">
                                                <svg class="w-3.5 h-3.5 mr-1" fill="none" stroke="currentColor" viewbox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                                                </svg>
                                                Réservé aux admins
                                            </span>
                                        {% endif %}
                                    </div>

                                    <div class="flex justify-between items-center mt-auto">
                                        <div>
                                            {% if program.pdfName %}
                                                <a href="{{ program.pdfUrl }}" target="_blank" class="inline-flex items-center text-sm text-blue-600 hover:text-blue-800">
                                                    <svg class="w-4 h-4 mr-1 text-red-500" fill="currentColor" viewbox="0 0 20 20">
                                                        <path fill-rule="evenodd" d="M4 4a2 2 0 012-2h4.586A2 2 0 0112 2.586L15.414 6A2 2 0 0116 7.414V16a2 2 0 01-2 2H6a2 2 0 01-2-2V4z" clip-rule="evenodd"/>
                                                    </svg>
                                                    Lien vers le PDF
                                                </a>
                                            {% else %}
                                                <span class="text-sm text-gray-400">Aucun PDF</span>
                                            {% endif %}
                                        </div>

                                        <div class="flex space-x-2">
                                            <a href="{{ path('admin_programs_edit', {'id': program.id}) }}" class="p-1 text-blue-600 hover:text-blue-800" title="Modifier">
                                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewbox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                                                </svg>
                                            </a>
                                            <form method="post" action="{{ path('admin_programs_delete', {'id': program.id}) }}" onsubmit="return confirm('Supprimer ?');">
                                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ program.id) }}">
                                                <button type="submit" class="p-1 text-red-600 hover:text-red-800" title="Supprimer">
                                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewbox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                                                    </svg>
                                                </button>
                                            </form>
                                        </div>
                                    </div>

                                    {% if program.updateAt %}
                                        <div class="mt-4 pt-4 border-t border-gray-100 text-xs text-gray-500">
                                            Dernière mise à jour : {{ program.updateAt|date('d/m/Y') }}
                                        </div>
                                    {% endif %}
                                </div>


                            {% endfor %}


                        </div>
                    </div>
                {% endfor %}
            {% else %}
                <div class="bg-white border border-gray-200 rounded-lg p-8 text-center">
                    <svg class="mx-auto h-12 w-12 text-gray-400 mb-4" fill="none" stroke="currentColor" viewbox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                    </svg>
                    {% if currentFilter == 'all' %}
                        <p class="text-gray-600 mb-4">Aucun document n'a été ajouté pour le moment</p>
                        <a href="{{ path('admin_programs_new') }}" class="inline-flex items-center px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700">
                            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewbox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                            </svg>
                            Créer le premier document
                        </a>
                    {% else %}
                        <p class="text-gray-600 mb-4">Aucun document n'a été ajouté {{ currentFilter == 'public' ? 'public' : 'privé' }} pour le moment</p>
                        <a href="{{ path('admin_programs_index', {'filter': 'all'}) }}" class="inline-flex items-center px-4 py-2 border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50">
                            Voir tous les documents
                        </a>
                    {% endif %}
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}